# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/domax

# Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=domax-submissions
AWS_ENDPOINT=https://s3.amazonaws.com

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# Email Service (SendGrid, AWS SES, etc.)
EMAIL_FROM=noreply@domax.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key

# Feature Flags
FEATURE_PLAGIARISM=true
FEATURE_ML_SCORING=false
FEATURE_SSO=false

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=



# Marking assistant (optional, off until AI_MODEL is set).
# Any local server that speaks the OpenAI chat protocol works: Ollama, LM Studio, llama.cpp, vLLM.
# Student work is only sent to this computer or your own network.
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=
# AI_API_KEY=
# Only after NCSA has authorised the transfer:
# AI_ALLOW_REMOTE=true
